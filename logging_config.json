{
  "log_levels": {
    "frontend": {
      "app": "INFO"
    },
    "backend": {
      "api": "DEBUG",
      "llm": "INFO",
      "database": "INFO"
    }
  },
  "llm_prompt_logging": {
    "enabled": false,
    "level": "DEBUG",
    "log_file": "backend/llm_prompts.log",
    "include_metadata": true,
    "include_timing": true,
    "include_full_response": true
  },
  "llm_verbose_logging": {
    "enabled": false,
    "level": "detailed",
    "providers": ["ollama", "openai"],
    "include_responses": true,
    "include_metadata": true,
    "log_file": "backend/llm_prompts_verbose.log",
    "max_file_size_mb": 50,
    "retention_days": 30,
    "sanitize_api_keys": true
  },
  "file_settings": {
    "enable_file_logging": true,
    "log_directory": "logs",
    "max_file_size_mb": 10,
    "max_backup_files": 5,
    "log_format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  "monitoring": {
    "enable_live_viewer": true,
    "max_recent_entries": 100,
    "auto_refresh_interval": 5000
  }
}